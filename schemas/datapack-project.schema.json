{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datapack-project.schema.json",
  "title": "Minecraft data pack harness project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness",
    "edition",
    "target_version",
    "namespace",
    "pack_root",
    "supported_versions",
    "experimental_features",
    "server_type",
    "validation_level",
    "cache_dir",
    "report_dir"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "commit"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "edition": {
      "const": "java"
    },
    "target_version": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "pack_root": {
      "type": "string",
      "minLength": 1
    },
    "supported_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "string"
        },
        "max": {
          "type": "string"
        }
      }
    },
    "experimental_features": {
      "type": "boolean"
    },
    "server_type": {
      "enum": [
        "vanilla"
      ]
    },
    "validation_level": {
      "enum": [
        "generated",
        "static",
        "server",
        "functional"
      ]
    },
    "cache_dir": {
      "type": "string",
      "minLength": 1
    },
    "report_dir": {
      "type": "string",
      "minLength": 1
    }
  }
}
